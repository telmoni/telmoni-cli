# ── Environment ───────────────────────────────────────────────────────────────
.env
# Every copy of it too: a backup like `.env.before-x` holds the same secrets.
.env.*
!.env.example

# ── AI / tooling state ────────────────────────────────────────────────────────
.claude/
.agents/
.gemini/
.aider*
.cursor/
skills

# ── Rust ──────────────────────────────────────────────────────────────────────
# Cargo.lock is committed for reproducible builds.
target/
*.rs.bk
# Crash core dumps (a linker OOM writes `core.<pid>` to the cwd). Numbered,
# so a source file named core.rs or core.ts is not ignored with them.
core.[0-9]*
# `cargo xtask dist` writes the release tarball and its checksums here.
dist/

# ── Local ─────────────────────────────────────────────────────────────────────
# The maintainer's own notes, never repo docs.
scratch/
*.log

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.zed/
.fleet/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.orig
*.rej
*.bak
.DS_Store
._*
Thumbs.db
Desktop.ini
