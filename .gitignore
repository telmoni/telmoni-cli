/target
**/*.rs.bk
# Crash core dumps (e.g. a linker OOM writes `core.<pid>` to the cwd): never committed.
# Numbered, so a source file named core.rs or core.ts is not ignored with them.
core.[0-9]*
*.log
.claude

# ── Scratch / planning ────────────────────────────────────────────────────────
scratch/

# `cargo xtask dist` writes the release tarball and its checksums here.
dist/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Editors & IDEs ────────────────────────────────────────────────────────────
.vscode/
.zed/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

# ── SDKs ──────────────────────────────────────────────────────────────────────
# The SDKs under `sdk/` are four ecosystems in one tree, and each vendors differently.
sdk/*/node_modules/
sdk/*/dist/
sdk/*/.venv/
sdk/**/__pycache__/
sdk/*/.pytest_cache/
sdk/*/.mypy_cache/
sdk/*/.ruff_cache/
sdk/**/*.egg-info/
*.egg-info/
*.pyc

# The plan is kept outside the repository, under scratch/.
/ROADMAP.md
