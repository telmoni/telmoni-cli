# Telmoni CLI configuration. Copy to `.env` (gitignored) and edit.
#
# The CLI reads `.env` from the directory you run it in, so this file applies to
# `cargo run` from the repository root. A real environment variable always wins
# over this file, and a flag wins over both.

# Where the CLI signs in and sends requests. Default: https://telmoni.com
# A local stack behind the Cloudflare tunnel:
TELMONI_ENDPOINT=https://local.telmoni.com
# TELMONI_ENDPOINT=https://telmoni.com

# The organization `status` and `logout` act on (`org_...`), instead of the one
# chosen at login.
# TELMONI_ORG=org_...

# Sign in with an API key instead of the browser device flow, for CI and other
# machines nobody sits at. Overridden by `--key`.
# TELMONI_API_KEY=telmoni_...
